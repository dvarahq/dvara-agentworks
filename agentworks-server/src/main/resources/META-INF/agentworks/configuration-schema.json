    {"name":"agentworks.artifacts.maximum-archive-expanded-size","type":"data-size","default":"256MB","constraint":"positive","sensitive":false,"owner":"artifact-store","reload":"restart","since":"1.0","status":"active","description":"Maximum expanded archive size."},
    {"name":"agentworks.artifacts.maximum-archive-expansion-ratio","type":"integer","default":"100","constraint":"1..10000","sensitive":false,"owner":"artifact-store","reload":"restart","since":"1.0","status":"active","description":"Maximum archive expansion ratio."},
