    {"name":"agentworks.gateway.enabled","type":"boolean","default":"true","constraint":"boolean","sensitive":false,"owner":"gateway","reload":"restart","since":"1.0","status":"active","description":"Enable model gateways."},
    {"name":"agentworks.gateway.gateways.<id>.type","type":"string","default":"","constraint":"registered adapter type","sensitive":false,"owner":"gateway","reload":"restart","since":"1.0","status":"active","description":"Gateway adapter type."},
    {"name":"agentworks.gateway.gateways.<id>.base-url","type":"uri","default":"","constraint":"fixed http or https URI","sensitive":false,"owner":"gateway","reload":"restart","since":"1.0","status":"active","description":"Gateway base URL."},
    {"name":"agentworks.gateway.gateways.<id>.credential-ref","type":"credential-ref","default":"","constraint":"non-empty reference","sensitive":true,"owner":"gateway","reload":"restart","since":"1.0","status":"active","description":"Gateway credential reference."},
