    {"name":"agentworks.artifacts.compute-maximum-output-size","type":"data-size","default":"16MB","constraint":"positive","sensitive":false,"owner":"artifact-store","reload":"restart","since":"1.0","status":"active","description":"Maximum artifact computation output size."},
