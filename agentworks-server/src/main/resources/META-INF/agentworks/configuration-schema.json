    {"name":"agentworks.artifacts.maintenance.enabled","type":"boolean","default":"true","constraint":"boolean","sensitive":false,"owner":"artifact-store","reload":"restart","since":"1.0","status":"active","description":"Enable artifact maintenance."},
    {"name":"agentworks.capabilities.runtime.compatibility","type":"string-list","default":"","constraint":"non-blank items","sensitive":false,"owner":"capabilities","reload":"restart","since":"1.0","status":"active","description":"Runtime compatibility facts."},
