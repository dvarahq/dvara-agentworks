    {"name":"agentworks.capabilities.runtime.detail-budget-tokens","type":"integer","default":"implementation default","constraint":"positive","sensitive":false,"owner":"capabilities","reload":"restart","since":"1.0","status":"active","description":"Capability detail token budget."},
