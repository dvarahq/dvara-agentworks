    {"name":"agentworks.client.credential-ref","type":"credential-ref","default":"","constraint":"non-empty reference","sensitive":true,"owner":"java-client","reload":"restart","since":"1.0","status":"active","description":"Opaque credential reference; material is never configuration."},
    {"name":"agentworks.client.request-timeout","type":"duration","default":"30s","constraint":"positive","sensitive":false,"owner":"java-client","reload":"restart","since":"1.0","status":"active","description":"Java client request timeout."},
    {"name":"agentworks.compatibility.allow-embedded-database","type":"boolean","default":"false","constraint":"boolean; forbidden in production","sensitive":false,"owner":"storage","reload":"restart","since":"1.0","status":"active","description":"Permit the test-only embedded database outside production."},
    {"name":"agentworks.console.enabled","type":"boolean","default":"true","constraint":"boolean","sensitive":false,"owner":"console","reload":"restart","since":"1.0","status":"active","description":"Enable the Web Console."},
    {"name":"agentworks.context.cache.maximum-entries","type":"integer","default":"1024","constraint":"positive","sensitive":false,"owner":"context","reload":"restart","since":"1.0","status":"active","description":"Maximum compiled-context cache entries."},
    {"name":"agentworks.credentials.enabled","type":"boolean","default":"true","constraint":"boolean","sensitive":false,"owner":"credentials","reload":"restart","since":"1.0","status":"active","description":"Enable credential-reference services."},
    {"name":"agentworks.credentials.environment.<id>.variable","type":"string","default":"","constraint":"environment variable name","sensitive":true,"owner":"credentials","reload":"restart","since":"1.0","status":"active","description":"Environment variable named by a credential reference."},
    {"name":"agentworks.credentials.environment.<id>.scope","type":"enum","default":"","constraint":"supported credential scope","sensitive":false,"owner":"credentials","reload":"restart","since":"1.0","status":"active","description":"Scope of an environment credential reference."},
    {"name":"agentworks.credentials.files.<id>.path","type":"path","default":"","constraint":"absolute mounted-secret path","sensitive":true,"owner":"credentials","reload":"restart","since":"1.0","status":"active","description":"Mounted secret path named by a credential reference."},
    {"name":"agentworks.credentials.files.<id>.scope","type":"enum","default":"","constraint":"supported credential scope","sensitive":false,"owner":"credentials","reload":"restart","since":"1.0","status":"active","description":"Scope of a file credential reference."},
