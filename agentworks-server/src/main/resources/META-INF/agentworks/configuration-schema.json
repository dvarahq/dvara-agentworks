    {"name":"agentworks.planes.run-plane.url","type":"uri","default":"primary datasource","constraint":"jdbc URL","sensitive":true,"owner":"storage","reload":"restart","since":"1.0","status":"active","description":"Run-Plane database URL; always redacted."},
