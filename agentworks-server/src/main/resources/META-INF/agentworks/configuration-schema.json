    {"name":"agentworks.gateway.gateways.<id>.max-stream-bytes","type":"data-size","default":"derived bounded value","constraint":"positive","sensitive":false,"owner":"gateway","reload":"restart","since":"1.0","status":"active","description":"Maximum bytes retained from a streaming response."},
