{
  "$id": "https://dvarahq.com/schemas/agentworks/configuration/v1",
  "format": "agentworks-configuration-catalog/v1",
  "title": "DVARA AgentWorks configuration",
  "description": "The supported AgentWorks-owned Spring Boot configuration surface. Dynamic identifiers replace angle-bracket placeholders.",
  "schemaVersion": 1,
  "compatibility": {
    "unknownKeys": "error",
    "removedKeys": "error",
    "deprecatedKeys": "warn",
    "precedence": ["command-line", "system-property", "environment-variable", "configuration-file", "profile-default"]
  },
  "properties": [
    {"name":"agentworks.configuration.diagnostics","type":"boolean","default":"false","constraint":"boolean","sensitive":false,"owner":"server","reload":"restart","since":"1.0","status":"active","description":"Log the origin and redacted effective value of explicitly configured AgentWorks settings."},
    {"name":"agentworks.configuration.unknown-keys","type":"enum","default":"error","constraint":"error|warn","sensitive":false,"owner":"server","reload":"restart","since":"1.0","status":"active","description":"Compatibility policy for unknown AgentWorks-owned keys."},
    {"name":"agentworks.agents.enabled","type":"boolean","default":"true","constraint":"boolean","sensitive":false,"owner":"agent-definition","reload":"restart","since":"1.0","status":"active","description":"Enable agent definition services."},
    {"name":"agentworks.artifacts.enabled","type":"boolean","default":"false","constraint":"boolean","sensitive":false,"owner":"artifact-store","reload":"restart","since":"1.0","status":"active","description":"Enable the artifact store."},
    {"name":"agentworks.artifacts.root","type":"path","default":"data/artifacts","constraint":"non-empty path","sensitive":true,"owner":"artifact-store","reload":"restart","since":"1.0","status":"active","description":"Artifact storage root; diagnostics never render the path."},
    {"name":"agentworks.artifacts.maximum-size","type":"data-size","default":"100MB","constraint":"positive","sensitive":false,"owner":"artifact-store","reload":"restart","since":"1.0","status":"active","description":"Maximum artifact size."},
    {"name":"agentworks.artifacts.compute-maximum-inputs","type":"integer","default":"32","constraint":"1..1024","sensitive":false,"owner":"artifact-store","reload":"restart","since":"1.0","status":"active","description":"Maximum inputs to one artifact computation."},
