  "non_work_tables": {
    "cohort_transition": "append-only cohort state history",
    "routing_target": "immutable route evidence",
    "lifecycle_decision": "immutable decision evidence",
    "agent_run_event": "append-only run history; its cohort_id is correlation evidence",
    "agent_run_checkpoint": "immutable checkpoint evidence; a restorable checkpoint is ledgered as a CHECKPOINT work item",
    "agent_run_effect": "effect ledger evidence; a pending effect is ledgered as an OPERATION work item",
    "session_inbox": "ordered inbox domain state and pinned delivery evidence; each non-terminal message is ledgered as an INBOX work item",
    "durable_operation": "durable provider-operation domain state and callback evidence; each non-terminal row is ledgered as an OPERATION work item",
    "child_run": "immutable causal child identity and exact parent/target pins; each non-terminal relationship is ledgered as CHILD_WORK on the parent cohort",
    "scheduled_wakeup": "database-time existing-run wakeup state; each scheduled row is ledgered as WAKEUP on the original cohort",
    "human_interaction": "interaction domain state and correlation evidence; each open row is ledgered as an INTERACTION work item",
    "sandbox_resource": "sandbox lifecycle and cleanup evidence; each non-terminal row is ledgered as a SANDBOX work item",
    "artifact_object": "immutable artifact ownership and provenance evidence; artifact pinning and lifecycle blockers remain owned by issue #84"
  }
}
