{
  "schemaVersion": 1,
  "release": {
    "version": "1.0.0-rc4",
    "tag": "v1.0.0-rc4",
    "canonicalRepository": "dvarahq/dvara-agentworks",
    "canonicalSource": "https://github.com/dvarahq/dvara-agentworks"
  },
  "freeze": {
    "state": "CANDIDATE",
    "baseline": "The immutable public release tag supplies the final frozen commit.",
    "allowedAfterFreeze": [
      "BLOCKER",
      "HIGH",
      "APPROVED_RELEASE_CRITICAL_MEDIUM"
    ],
    "requireFullGateRerunAfterChange": true
  },
  "requiredPriorReleaseBlockers": [14],
  "requiredArtifactKinds": ["maven", "cli", "oci", "helm"],
  "requiredPasses": ["protected-ci", "independent-clean"],
  "requiredGates": [
    "repository-policy",
    "traceability",
    "documentation",
    "compatibility",
    "supply-chain",
    "security",
    "full-regression",
    "walking-skeleton",
    "clean-install",
    "supported-upgrade",
    "rollback",
    "backup-restore",
    "disaster-recovery",
    "load",
    "soak"
  ],
  "minimumSoakHours": 24,
  "minimumStabilizationHours": 168,
  "evidence": {
    "template": "config/release/rc4-evidence-template.json",
    "runbook": "docs/operations/rc4.md",
    "goNoGoReport": "docs/release/rc4-go-no-go.md"
  }
}
